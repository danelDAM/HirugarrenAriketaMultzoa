<Window x:Class="ariketa10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">

    <Grid>

        <Label Content="NIRE IRUDIAK"
               HorizontalAlignment="Left"
               Margin="280,53,0,0"
               VerticalAlignment="Top"/>

        <Label Content="1. Ilara:"
               HorizontalAlignment="Left"
               Margin="63,124,0,0"
               VerticalAlignment="Top"/>

        <ComboBox x:Name="comboImagen"
                  HorizontalAlignment="Left"
                  Height="23"
                  Margin="63,150,0,0"
                  VerticalAlignment="Top"
                  Width="93"
                  SelectionChanged="comboImagen_SelectionChanged">

            <ComboBoxItem Content="Irudia 1"/>
            <ComboBoxItem Content="Irudia 2"/>
            <ComboBoxItem Content="Irudia 3"/>

        </ComboBox>


        <Label Content="2.Ilara:"
               HorizontalAlignment="Left"
               Margin="63,278,0,0"
               VerticalAlignment="Top"/>

        <CheckBox x:Name="checkImagen1"
                  Content="Irudia 4"
                  HorizontalAlignment="Left"
                  Margin="72,311,0,0"
                  VerticalAlignment="Top"
                  Checked="CheckBox_Checked"
                  Unchecked="CheckBox_Unchecked"/>

        <CheckBox x:Name="checkImagen2"
                  Content="Irudia 5"
                  HorizontalAlignment="Left"
                  Margin="72,334,0,0"
                  VerticalAlignment="Top"
                  Checked="CheckBox_Checked"
                  Unchecked="CheckBox_Unchecked"/>

        <CheckBox x:Name="checkImagen3"
                  Content="Irudia 6"
                  HorizontalAlignment="Left"
                  Margin="72,357,0,0"
                  VerticalAlignment="Top"
                  Checked="CheckBox_Checked"
                  Unchecked="CheckBox_Unchecked"/>


        <Image x:Name="irudi1"
               Source="/images/logoDonosti.png"
               HorizontalAlignment="Left"
               Height="109"
               Visibility="Hidden"
               Margin="204,124,0,0"
               VerticalAlignment="Top"
               Width="152"/>

        <Image x:Name="irudi2"
               Source="/images/logoBarcelona.png"
               HorizontalAlignment="Left"
               Height="109"
               Visibility="Hidden"
               Margin="374,124,0,0"
               VerticalAlignment="Top"
               Width="152"/>

        <Image x:Name="irudi3"
               Source="/images/logoMalaga.png"
               HorizontalAlignment="Left"
               Height="109"
               Visibility="Hidden"
               Margin="546,124,0,0"
               VerticalAlignment="Top"
               Width="152"/>


        <Image x:Name="irudi4"
               Source="/images/logoMadrid.png"
               HorizontalAlignment="Left"
               Height="109"
               Visibility="Hidden"
               Margin="204,249,0,0"
               VerticalAlignment="Top"
               Width="152"/>

        <Image x:Name="irudi5"
               Source="/images/logoDonosti.png"
               HorizontalAlignment="Left"
               Height="109"
               Visibility="Hidden"
               Margin="374,249,0,0"
               VerticalAlignment="Top"
               Width="152"/>

        <Image x:Name="irudi6"
               Source="/images/logoBarcelona.png"
               Visibility="Hidden"
               HorizontalAlignment="Left"
               Height="109"
               Margin="546,249,0,0"
               VerticalAlignment="Top"
               Width="152"/>
        <Button Content="Irten" HorizontalAlignment="Left" Height="30" Margin="652,384,0,0" VerticalAlignment="Top" Width="113" Click="irten"/>

    </Grid>
</Window>