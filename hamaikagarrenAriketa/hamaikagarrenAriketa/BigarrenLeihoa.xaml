<Window x:Class="hamaikagarrenAriketa.BigarrenLeihoa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aldagai orokorrak bistaratu"
        Height="300"
        Width="450">

    <Grid>

        <Label Content="Ongi etorri sistemara"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,10,0,0"
               FontSize="24"
               FontWeight="Bold"/>


        <Label x:Name="lblIzena"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="90,70,0,0"
               FontSize="16"
               Width="120"/>


        <Label x:Name="lblNAN"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Margin="245,70,0,0"
               FontSize="16"
               Width="130"/>


        <Label x:Name="lblLehenAbizena"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,105,0,0"
               FontSize="16"
               Width="180"/>


        <Label x:Name="lblBigarrenAbizena"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,140,0,0"
               FontSize="16"
               Width="180"/>


        <Button Content="Irten"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Width="80"
                Height="35"
                Click="btnIrten_Click"/>

    </Grid>

</Window>