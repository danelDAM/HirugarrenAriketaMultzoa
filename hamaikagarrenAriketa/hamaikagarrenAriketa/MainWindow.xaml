<Window x:Class="hamaikagarrenAriketa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datuak sartu"
        Height="450"
        Width="800">

    <Grid>

        <TextBox x:Name="txtIzena"
                 HorizontalAlignment="Left"
                 Height="34"
                 Margin="423,82,0,0"
                 VerticalAlignment="Top"
                 Width="209"/>

        <TextBox x:Name="txtLehenAbizena"
                 HorizontalAlignment="Left"
                 Height="34"
                 Margin="423,134,0,0"
                 VerticalAlignment="Top"
                 Width="209"/>

        <TextBox x:Name="txtBigarrenAbizena"
                 HorizontalAlignment="Left"
                 Height="34"
                 Margin="423,183,0,0"
                 VerticalAlignment="Top"
                 Width="209"/>

        <TextBox x:Name="txtNAN"
                 HorizontalAlignment="Left"
                 Height="34"
                 Margin="423,235,0,0"
                 VerticalAlignment="Top"
                 Width="209"/>


        <Label Content="Izena"
               HorizontalAlignment="Left"
               Height="34"
               Margin="188,82,0,0"
               VerticalAlignment="Top"
               Width="109"/>

        <Label Content="1.abizena"
               HorizontalAlignment="Left"
               Height="34"
               Margin="188,133,0,0"
               VerticalAlignment="Top"
               Width="109"/>

        <Label Content="2.abizena"
               HorizontalAlignment="Left"
               Height="34"
               Margin="188,183,0,0"
               VerticalAlignment="Top"
               Width="109"/>

        <Label Content="NAN"
               HorizontalAlignment="Left"
               Height="34"
               Margin="188,234,0,0"
               VerticalAlignment="Top"
               Width="109"/>


        <Button Content="Onartu"
                HorizontalAlignment="Left"
                Height="35"
                Margin="172,335,0,0"
                VerticalAlignment="Top"
                Width="125"
                Click="btnOnartu_Click"/>

        <Button Content="Kargatu eta bistaratu"
                HorizontalAlignment="Left"
                Height="35"
                Margin="356,335,0,0"
                VerticalAlignment="Top"
                Width="126"
                Click="btnKargatu_Click"/>

        <Button Content="Irten"
                HorizontalAlignment="Left"
                Height="35"
                Margin="552,335,0,0"
                VerticalAlignment="Top"
                Width="124"
                Click="btnIrten_Click"/>

    </Grid>

</Window>